{
  "entities": {
    "Owner": {
      "title": "Owner Profile",
      "description": "Bus owner profile with plan type and financial summary",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "email": { "type": "string" },
        "name": { "type": "string" },
        "companyName": { "type": "string" },
        "planType": { "type": "string" },
        "activeBusesCount": { "type": "number" },
        "todayRevenue": { "type": "number" },
        "walletBalance": { "type": "number" },
        "saasFeePerBus": { "type": "number" },
        "subscriptionTier": { "type": "string" },
        "subscriptionPlanName": { "type": "string" },
        "subscriptionSelectedAt": { "type": "string" },
        "isAdmin": { "type": "boolean" },
        "nextPayoutDate": { "type": "string" },
        "nextPayoutAmount": { "type": "number" },
        "avgDailyRiders": { "type": "number" },
        "city": { "type": "string" },
        "phone": { "type": "string" }
      }
    },
    "Bus": {
      "title": "Bus Vehicle",
      "description": "Bus vehicle record in owner fleet",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "ownerId": { "type": "string" },
        "regNumber": { "type": "string" },
        "model": { "type": "string" },
        "capacity": { "type": "number" },
        "lastServiceDate": { "type": "string" },
        "nextServiceDue": { "type": "string" },
        "status": { "type": "string" },
        "routeAssigned": { "type": "string" },
        "monthlyLeasePayout": { "type": "number" }
      }
    },
    "Route": {
      "title": "SaaS Route",
      "description": "Configured intercity or suburban bus route",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "ownerId": { "type": "string" },
        "routeName": { "type": "string" },
        "origin": { "type": "string" },
        "destination": { "type": "string" },
        "distanceKm": { "type": "number" },
        "fixedCharge": { "type": "number" },
        "ratePerKm": { "type": "number" },
        "computedFare": { "type": "number" },
        "tripsPerDay": { "type": "number" },
        "permitType": {
          "type": "string",
          "enum": ["stage_carriage", "contract_carriage", "tourist_permit", "unverified"]
        },
        "permitNumber": { "type": "string" }
      }
    },
    "EarningsEntry": {
      "title": "Daily Earnings Entry",
      "description": "Daily ticket revenue record with channel breakdown",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "ownerId": { "type": "string" },
        "day": { "type": "string" },
        "date": { "type": "string" },
        "ticketRevenue": { "type": "number" },
        "cashAmount": { "type": "number" },
        "upiAmount": { "type": "number" },
        "cardAmount": { "type": "number" }
      }
    },
    "PayoutEntry": {
      "title": "Lease Payout Entry",
      "description": "Monthly guaranteed payout history entry",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "ownerId": { "type": "string" },
        "payoutDate": { "type": "string" },
        "amount": { "type": "number" },
        "status": { "type": "string" },
        "transactionId": { "type": "string" },
        "busCount": { "type": "number" }
      }
    },
    "MaintenanceRecord": {
      "title": "Maintenance Log Record",
      "description": "Vehicle service and repair audit record",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "ownerId": { "type": "string" },
        "busId": { "type": "string" },
        "busReg": { "type": "string" },
        "serviceType": { "type": "string" },
        "serviceDate": { "type": "string" },
        "nextDueDate": { "type": "string" },
        "cost": { "type": "number" },
        "mechanicShop": { "type": "string" },
        "notes": { "type": "string" }
      }
    },
    "Driver": {
      "title": "Driver Profile",
      "description": "Bus driver profile, commercial license validity, and route assignment",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "ownerId": { "type": "string" },
        "employeeId": { "type": "string" },
        "name": { "type": "string" },
        "phone": { "type": "string" },
        "emergencyContact": { "type": "string" },
        "bloodGroup": { "type": "string" },
        "status": { "type": "string" },
        "licenseNumber": { "type": "string" },
        "licenseType": { "type": "string" },
        "badgeNumber": { "type": "string" },
        "licenseExpiryDate": { "type": "string" },
        "assignedBusId": { "type": "string" },
        "assignedBusReg": { "type": "string" },
        "assignedRouteId": { "type": "string" },
        "assignedRouteName": { "type": "string" },
        "shiftTiming": { "type": "string" },
        "experienceYears": { "type": "number" },
        "joiningDate": { "type": "string" },
        "safetyScore": { "type": "number" },
        "tripsCompleted": { "type": "number" },
        "notes": { "type": "string" }
      }
    },
    "PlatformPricing": {
      "title": "Platform Pricing Settings",
      "description": "Admin configurable SaaS tier rates per bus per month",
      "type": "object",
      "properties": {
        "starterRate": { "type": "number" },
        "growthRate": { "type": "number" },
        "enterpriseRate": { "type": "number" },
        "updatedAt": { "type": "string" },
        "updatedBy": { "type": "string" }
      }
    }
  },
  "firestore": {
    "/platform_settings/{settingId}": {
      "schema": "PlatformPricing",
      "description": "Platform global subscription tier rates"
    },
    "/owners/{ownerId}": {
      "schema": "Owner",
      "description": "Owner profile data"
    },
    "/buses/{busId}": {
      "schema": "Bus",
      "description": "Owner fleet buses"
    },
    "/routes/{routeId}": {
      "schema": "Route",
      "description": "Owner routes for SaaS calculation"
    },
    "/earnings/{entryId}": {
      "schema": "EarningsEntry",
      "description": "SaaS daily revenue collection logs"
    },
    "/payouts/{payoutId}": {
      "schema": "PayoutEntry",
      "description": "Lease monthly payout records"
    },
    "/maintenance/{maintId}": {
      "schema": "MaintenanceRecord",
      "description": "Bus maintenance and service records"
    },
    "/drivers/{driverId}": {
      "schema": "Driver",
      "description": "Driver profiles and license compliance"
    }
  }
}
