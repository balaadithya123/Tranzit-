rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if the caller is an authenticated platform admin
    function isAdmin() {
      return request.auth != null && (
        request.auth.token.admin == true ||
        (exists(/databases/$(database)/documents/owners/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/owners/$(request.auth.uid)).data.isAdmin == true)
      );
    }

    // Helper to check if resource belongs to authenticated owner or demo data
    function isOwnerOrAdmin(ownerId) {
      return (request.auth != null && (request.auth.uid == ownerId || isAdmin())) ||
             ownerId == 'owner-saas-demo-uid' ||
             ownerId == 'owner-lease-demo-uid' ||
             ownerId == 'demo-saas-owner-rajesh' ||
             ownerId == 'demo-lease-owner-vikram';
    }

    // Platform pricing settings
    match /platform_settings/{settingId} {
      allow read: if true;
      allow write: if true;
    }

    // Owner profiles
    match /owners/{ownerId} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    // Fleet buses
    match /buses/{busId} {
      allow read, write: if true;
    }

    // Routes
    match /routes/{routeId} {
      allow read, write: if true;
    }

    // Earnings
    match /earnings/{entryId} {
      allow read, write: if true;
    }

    // Payouts
    match /payouts/{payoutId} {
      allow read, write: if true;
    }

    // Maintenance records
    match /maintenance/{maintId} {
      allow read, write: if true;
    }

    // Drivers
    match /drivers/{driverId} {
      allow read, write: if true;
    }
  }
}
